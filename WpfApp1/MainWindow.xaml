<Window x:Class="RecipeWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recipe Manager"
        Height="600"
        Width="1000">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="LightSkyBlue"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Height" Value="40"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Рядки -->
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Колонки -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="LightBlue"
                Padding="10">
            <TextBlock Text="Recipe Manager"
                       FontSize="24"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Ліва панель -->
        <StackPanel Grid.Row="1"
                    Grid.Column="0"
                    Margin="10">

            <Button x:Name="buttonAdd"
                    Content="Додати"
                    Click="ButtonAdd_Click"/>

            <Button x:Name="buttonEdit"
                    Content="Редагувати"
                    Click="ButtonEdit_Click"/>

            <Button x:Name="buttonDelete"
                    Content="Видалити"
                    Click="ButtonDelete_Click"/>

            <Button x:Name="buttonSave"
                    Content="Зберегти"
                    Click="ButtonSave_Click"/>

            <Button x:Name="buttonLoad"
                    Content="Завантажити"
                    Click="ButtonLoad_Click"/>
        </StackPanel>

        <!-- Таблиця -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Background="White"
                Padding="10">

            <DataGrid x:Name="dataGridRecipes"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}"
                                        Width="*"/>

                    <DataGridTextColumn Header="Cooking Time"
                                        Binding="{Binding CookingTime}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Difficulty"
                                        Binding="{Binding Difficulty}"
                                        Width="100"/>

                    <DataGridTextColumn Header="Created At"
                                        Binding="{Binding CreatedAt}"
                                        Width="180"/>

                    <DataGridCheckBoxColumn Header="Vegetarian"
                                            Binding="{Binding IsVegetarian}"
                                            Width="100"/>
                </DataGrid.Columns>

            </DataGrid>
        </Border>
    </Grid>
</Window>